DDB_ENDPOINT_URL=
DDB_TABLE_PREFIX=hypd-demo

AWS_REGION=ap-south-1

# === 应用 ===
APP_ENV=local
LOG_LEVEL=INFO

# === 认证 ===
# 先 mock 跳过认证, 后续接入 cognito
AUTH_MODE=cognito
MOCK_ADMIN_USER_ID=00000000-0000-0000-0000-000000000001
COGNITO_USER_POOL_ID=ap-south-1_pool_id
COGNITO_CLIENT_ID=your_cognito_clinet_id
COGNITO_REGION=ap-south-1
COGNITO_DOMAIN=ap-south-pool_id.auth.ap-south-1.amazoncognito.com
LOCAL_CALLBACK_URL=http://localhost:5173/auth/callback

HYPERPOD_CLUSTER_NAME=hp-fsx-demo-cluster
PLATFORM_POD_ROLE_ARN=arn:aws:iam::<account-id>:role/platform-pod-role
EKS_CLUSTER_NAME=hp-fsx-demo
# 预拼好的完整 CloudWatch log group 名 (/aws/sagemaker/Clusters/{tag}/{cluster-id-suffix})。
# 设置后日志 resolver 直接用它, 跳过 ws_get + SageMaker DescribeCluster (单集群部署提速);
# 留空则回退按 ws->cluster 动态推导 (多集群)。
LOG_GROUP_NAME=/aws/sagemaker/Clusters/hp-fsx-demo-cluster/xxxxxxxxxxxx
PLATFORM_FSX_ID=fs-0123456789abcdef0
DEV_PROXY_LOCAL_TARGET=localhost:18888
ENABLE_DEV_PROXY_QUERY_TOKEN=true

SSM_MANAGED_NODE_ROLE_ARN=arn:aws:iam::123456789012:role/sagemaker-space-SSMManagedNode-20260526

IDC_IDENTITY_STORE_ID=d-1234567890
# 跨账号: IdC 在 org 管理账号、应用在另一个账号时, 填管理账号只读角色 ARN
# (后端先 sts:AssumeRole 再建 identitystore client). 同账号留空。
# IDC_REGION / IDC_IDENTITY_STORE_ID 仍要填管理账号那个 store 的值。
# IDC_ASSUME_ROLE_ARN=arn:aws:iam::<mgmt-account-id>:role/hyperpod-idc-readonly

PLATFORM_S3_BUCKETS=hyperpod-test-dataset-ap-south-1:ap-south-1

AMP_WORKSPACE_ID=AMP-ws-id