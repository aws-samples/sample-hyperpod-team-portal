# platform-worker 配置 · 拷成 .env 填真实值。
# worker 是独立 ECS service, 只需 AWS / DDB / EKS, 不需要 api 的 Cognito/IdC/FSx/S3/ALB。

# ===== AWS =====
AWS_REGION=us-west-2
# 本地用命名 profile (例 my-profile); 生产 ECS 走 task role, 留空
AWS_PROFILE=

# ===== DynamoDB (informer 写 ResourceIndex.phase) =====
DDB_TABLE_PREFIX=hypd-demo
# 留空走真 AWS; 设 http://localhost:8000 走 DDB Local
DDB_ENDPOINT_URL=

# ===== K8s / EKS (informer watch HyperPodPyTorchJob CR) =====
EKS_CLUSTER_NAME=eks-hypd-demo
HYPERPOD_CLUSTER_NAME=hp-cluster-hypd-demo
# 留空 = 用 kubeconfig 当前 context (kubectl config current-context)
KUBE_CONTEXT=
