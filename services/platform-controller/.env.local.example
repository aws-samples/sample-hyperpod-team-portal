# 本地运行 platform-controller 的环境变量样例。
#
# 用法:
#   cp .env.local.example .env.local   # 复制后填入真实值
#   set -a && source .env.local && set +a && go run ./cmd/controller
#
# (.env.local 已被 .gitignore 忽略, 不会提交; 本 .example 可提交作模板)
#
# 前置: 先把 kubectl current-context 切到业务集群 (集群 Y, hyperpod):
#   kubectl config use-context arn:aws:eks:us-west-2:123456789012:cluster/my-hyperpod-eks

# ── 业务集群 (集群 Y) kubeconfig: informer watch 它 ──
# ~/.kube/config 由 aws eks update-kubeconfig 生成, 已含 aws eks get-token exec
# (client-go 据此自动刷 EKS 15min token)。用其 current-context, 故上面要先切对。
# (Pod 里此变量由 entrypoint 自动生成, 只需传 BUSINESS_EKS_CLUSTER_NAME; 本地才手填路径。)
BUSINESS_KUBECONFIG=/Users/foxqin/.kube/config

# ── 平台集群 (集群 X) kubeconfig ──
# 本地跑指向同一个 kubeconfig, 避免代码走 in-cluster config 报错。
# (Pod 里此变量留空 → 走 in-cluster SA; 本地才手填路径。)
PLATFORM_KUBECONFIG=/Users/foxqin/.kube/config

# ── 本地关掉 leader election (不需要 lease) ──
ENABLE_LEADER_ELECTION=false

# ── DynamoDB ──
# 用 `aws dynamodb list-tables --region us-west-2 --profile <p> | grep -i resource` 查表名。
# ⚠️ 指向测试环境的表, 别指生产。
DDB_TABLE=REPLACE_ME_resource_index_table

# ── AWS 凭证 / region ──
AWS_PROFILE=REPLACE_ME_profile
AWS_REGION=us-west-2

# ── 可选: 只 watch 带此 label 的对象 (控 cache 内存); 本地验证可留空 ──
# WATCH_LABEL_SELECTOR=platform.hyperpod.io/managed=true
