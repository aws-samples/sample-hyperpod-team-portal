{
  "name": "hyperpod-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "gen:api": "openapi-typescript ../services/platform-api/openapi.json -o src/shared/api/schema.gen.ts",
    "check:api": "openapi-typescript ../services/platform-api/openapi.json -o /tmp/schema.gen.check.ts && diff /tmp/schema.gen.check.ts src/shared/api/schema.gen.ts",
    "check:imports": "node scripts/check-imports.mjs",
    "check:validation": "node scripts/check-validation-sync.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@ant-design/pro-components": "^2.8.2",
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-query": "^5.100.9",
    "@types/js-yaml": "^4.0.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "anser": "^2.3.5",
    "antd": "^5.22.2",
    "axios": "^1.16.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "i18next": "^26.5.11",
    "js-yaml": "^4.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.9",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.59.1",
    "pptxgenjs": "^4.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.5"
  }
}
